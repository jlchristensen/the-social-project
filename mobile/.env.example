# Supabase — the same project the website uses.
# Copy this file to `mobile/.env` and fill in the two values.
#
# Find them at: supabase.com → your project → Settings → API
# They are the SAME values as NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY in the website's .env.local — only the
# prefix differs, because Expo requires EXPO_PUBLIC_ to expose a variable
# to the app.
#
# The anon key is safe to ship in a client app: it grants nothing on its
# own, and every table is protected by row-level security policies.

EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
