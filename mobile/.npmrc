# Expo SDK 57 pins react@19.2.3, but expo-router pulls react-dom@19.2.7 for its
# web target (which this app doesn't use), and that demands react ^19.2.7.
# The conflict is cosmetic for a native-only app; npm's strict peer resolution
# refuses the install without this.
#
# If the app ever targets web, revisit this rather than leaving it in place.
legacy-peer-deps=true
